{
  "name": "@powehig/dsh-arch-lab",
  "version": "2.0.0",
  "type": "module",
  "description": "Architecture microscope for DeepSeek Harness: per-layer 3D structural cutaways and 2D maps of frontier LLM papers, with tensor shapes, formulas and parameter math.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host2.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "client.js",
    "host2.js",
    "cordis.patch.yml",
    "build.mjs",
    "LICENSE",
    "icon.svg",
    "assets/*.png",
    "data/*.json",
    "locale/*.json",
    "vendor/*",
    "src/*",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "Zhiyi Gao",
    "url": "https://github.com/PowehiG"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowehiG/dsh-arch-lab.git"
  },
  "homepage": "https://github.com/PowehiG/dsh-arch-lab#readme",
  "bugs": {
    "url": "https://github.com/PowehiG/dsh-arch-lab/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "llm",
    "architecture",
    "visualization",
    "threejs",
    "moe",
    "mla",
    "dsa",
    "paper"
  ],
  "publishConfig": {
    "access": "public"
  }
}
